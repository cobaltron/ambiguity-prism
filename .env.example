# Copy this file to .env and fill in your key.
#   cp .env.example .env            (bash)
#   Copy-Item .env.example .env     (PowerShell)
#
# .env is gitignored. A real environment variable overrides anything set here,
# so `TYPESAFE_API_KEY=... npm run serve` works without editing this file.
# Only the local proxy process reads the key; it is never sent to the page.

# Required. Get one at https://jevplayground.com/jev-api
TYPESAFE_API_KEY=

# Optional. Defaults to https://api.typesafe.ai
# The provider appends /v1/systemone to this.
# TYPESAFE_API_BASE=https://api.typesafe.ai

# Optional. Defaults to the pinned jev-1.13.0.
# The aliases jev-latest and jev-preview are REFUSED: a silent version bump
# would invalidate the calibrated thresholds and the cache at the same time.
# TYPESAFE_MODEL=jev-1.13.0

# Optional. Local proxy bind.
# PRISM_PORT=8787
# PRISM_HOST=127.0.0.1

# Optional. Only for running the test double deliberately; there is no automatic
# fallback. Values from this are a rule table, not a model, and are labelled
# synthetic in every output.
# PRISM_PROVIDER=heuristic
